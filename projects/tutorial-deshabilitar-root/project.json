          "markup": "<section data-label=\"Paso 6\" data-speaker-notes=\"Deshabilitamos el acceso remoto de root editando sshd_config con PermitRootLogin no, y reiniciamos el servicio SSH.\" class=\"sd\">\n    <div class=\"steplabel\" style=\"margin-bottom:16px;\">PASO 06</div>\n    <h2 style=\"margin-bottom:var(--gap-title);\">Deshabilitar root por SSH</h2>\n    <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:26px 40px;max-width:1620px;align-items:start;\">\n      <div>\n        <div class=\"cap\">EDITAR LA CONFIGURACIÓN</div>\n        <div class=\"cmd\"><span style=\"color:var(--green);\">$</span> nano /etc/ssh/sshd_config</div>\n      </div>\n      <div>\n        <div class=\"cap\">REINICIAR EL SERVICIO</div>\n        <div class=\"cmd\"><span style=\"color:var(--green);\">$</span> systemctl restart ssh</div>\n      </div>\n    </div>\n    <div style=\"max-width:1200px;margin-top:34px;\">\n      <div class=\"cap\" style=\"color:var(--amber);\">CONFIGURAR ESTA DIRECTIVA</div>\n      <div class=\"cmd\" style=\"border-color:rgba(230,185,92,.35);\"><span style=\"color:var(--blue);\">PermitRootLogin</span> <span style=\"color:var(--amber);\">no</span></div>\n    </div>\n    <div class=\"foot\">Hardening de root · Linux</div>\n    <div class=\"dot\">09</div>\n  </section>"
