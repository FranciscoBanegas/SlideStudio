          "markup": "<section data-label=\"Comparativa\" data-speaker-notes=\"Resumen del antes y el después. Recorre cada fila mostrando cómo cada control mueve el sistema de la columna izquierda a la derecha.\" class=\"sd\" style=\"padding-top:70px;padding-bottom:60px;\">\n    <div class=\"steplabel\" style=\"margin-bottom:14px;\">RESULTADO</div>\n    <h2 style=\"margin-bottom:30px;\">Antes y después</h2>\n    <table class=\"mono\" style=\"width:100%;border-collapse:collapse;font-size:23px;\">\n      <thead>\n        <tr>\n          <th style=\"text-align:left;padding:12px 18px;color:var(--muted);font-weight:600;border-bottom:1px solid var(--line2);\">Aspecto</th>\n          <th style=\"text-align:left;padding:12px 18px;color:var(--red);font-weight:600;border-bottom:1px solid var(--line2);\">Sin esta configuración</th>\n          <th style=\"text-align:left;padding:12px 18px;color:var(--green);font-weight:600;border-bottom:1px solid var(--line2);\">Con esta configuración</th>\n        </tr>\n      </thead>\n      <tbody style=\"color:var(--ink);\">\n        <tr><td style=\"padding:10px 18px;border-bottom:1px solid var(--line);\">Login directo de root</td><td style=\"padding:10px 18px;border-bottom:1px solid var(--line);color:var(--muted);\">Permitido</td><td style=\"padding:10px 18px;border-bottom:1px solid var(--line);\">Bloqueado (nologin)</td></tr>\n        <tr><td style=\"padding:10px 18px;border-bottom:1px solid var(--line);\">Acceso SSH de root</td><td style=\"padding:10px 18px;border-bottom:1px solid var(--line);color:var(--muted);\">Posible</td><td style=\"padding:10px 18px;border-bottom:1px solid var(--line);\">Deshabilitado</td></tr>\n        <tr><td style=\"padding:10px 18px;border-bottom:1px solid var(--line);\">Administración diaria</td><td style=\"padding:10px 18px;border-bottom:1px solid var(--line);color:var(--muted);\">Root</td><td style=\"padding:10px 18px;border-bottom:1px solid var(--line);\">Usuario con sudo</td></tr>\n        <tr><td style=\"