          "markup": "<section data-label=\"Paso 8\" data-speaker-notes=\"Instalamos y activamos auditd para registrar las acciones administrativas y ganar trazabilidad.\" class=\"sd\">\n    <div class=\"steplabel\" style=\"margin-bottom:16px;\">PASO 08</div>\n    <h2 style=\"margin-bottom:var(--gap-title);\">Registrar acciones administrativas</h2>\n    <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:26px 40px;max-width:1620px;align-items:start;\">\n      <div>\n        <div class=\"cap\">DEBIAN / UBUNTU</div>\n        <div class=\"cmd\"><span style=\"color:var(--green);\">$</span> apt install auditd</div>\n      </div>\n      <div>\n        <div class=\"cap\">RHEL / CENTOS</div>\n        <div class=\"cmd\"><span style=\"color:var(--green);\">$</span> dnf install audit</div>\n      </div>\n    </div>\n    <div style=\"max-width:1200px;margin-top:34px;\">\n      <div class=\"cap\">HABILITAR E INICIAR</div>\n      <div class=\"cmd\" style=\"line-height:1.8;\">\n        <span style=\"color:var(--green);\">$</span> systemctl enable auditd<br>\n        <span style=\"color:var(--green);\">$</span> systemctl start auditd\n      </div>\n    </div>\n    <div class=\"foot\">Hardening de root · Linux</div>\n    <div class=\"dot\">11</div>\n  </section>"
