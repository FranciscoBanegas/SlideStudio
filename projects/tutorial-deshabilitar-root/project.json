          "markup": "<section data-label=\"Portada\" data-speaker-notes=\"Presenta el objetivo del tutorial: convertir root en una cuenta que no puede iniciar sesión y trabajar siempre con un usuario administrador auditado.\" class=\"sd\" style=\"justify-content:center;\">\n    <div style=\"font-family:'IBM Plex Mono',monospace;font-size:26px;color:var(--green);letter-spacing:2px;margin-bottom:30px;\">root@servidor:~# hardening --guia-paso-a-paso</div>\n    <h2 style=\"font-size:88px;max-width:1500px;\">Deshabilitar el inicio de sesión de root</h2>\n    <div style=\"font-size:var(--type-sub);color:var(--muted);margin-top:24px;font-weight:400;\">y utilizar un usuario administrador</div>\n    <div style=\"display:flex;gap:16px;margin-top:56px;\">\n      <span class=\"mono\" style=\"border:1px solid var(--line2);border-radius:999px;padding:12px 26px;font-size:var(--type-small);color:var(--ink);\">12 pasos</span>\n      <span class=\"mono\" style=\"border:1px solid var(--line2);border-radius:999px;padding:12px 26px;font-size:var(--type-small);color:var(--ink);\">Debian · Ubuntu · RHEL</span>\n      <span class=\"mono\" style=\"border:1px solid var(--line2);border-radius:999px;padding:12px 26px;font-size:var(--type-small);color:var(--ink);\">Nivel intermedio</span>\n    </div>\n    <div class=\"dot\">01</div>\n  </section>"
        }
