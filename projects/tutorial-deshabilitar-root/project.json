          "markup": "<section data-label=\"Paso 2\" data-speaker-notes=\"Verificamos que el usuario puede elevar privilegios. sudo whoami debe devolver root.\" class=\"sd\">\n    <div class=\"steplabel\" style=\"margin-bottom:16px;\">PASO 02</div>\n    <h2 style=\"margin-bottom:var(--gap-title);\">Probar sudo</h2>\n    <div style=\"max-width:1200px;\">\n      <div class=\"cap\">CAMBIAR AL USUARIO Y ELEVAR PRIVILEGIOS</div>\n      <div class=\"cmd\" style=\"line-height:1.8;\">\n        <span style=\"color:var(--green);\">$</span> su - administrador<br>\n        <span style=\"color:var(--green);\">$</span> sudo whoami\n      </div>\n    </div>\n    <div style=\"max-width:1200px;margin-top:34px;\">\n      <div class=\"cap\" style=\"color:var(--green);\">DEBE DEVOLVER</div>\n      <div class=\"cmd\" style=\"border-color:rgba(92,212,138,.35);color:var(--green);\">root</div>\n    </div>\n    <div class=\"foot\">Hardening de root · Linux</div>\n    <div class=\"dot\">05</div>\n  </section>"
